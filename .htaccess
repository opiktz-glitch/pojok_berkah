# Pojok Berkah - Apache configuration for shared hosting (InfinityFree)
# Request the free SSL certificate in the hosting panel before publishing so
# that HTTP visitors can be redirected. Requests to localhost are left on HTTP
# so the site keeps working in a local XAMPP setup.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Artikel diterbitkan dari CMS, tanpa membuat file HTML manual.
  RewriteRule ^artikel/?$ artikel.php [QSA,L]
  RewriteRule ^artikel/([a-z0-9-]+)\.html$ artikel.php?slug=$1 [QSA,L,NC]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Redirect www to non-www first, straight to HTTPS non-www (single hop).
  # Placed before the HTTPS rule so http://www goes directly to
  # https://non-www instead of http-www -> https-www -> https-non-www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Force HTTPS for real hostnames. The proxy in front of Apache may terminate
  # TLS, so both the HTTPS variable and the forwarded protocol header are
  # checked. Local development hostnames are excluded.
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Halaman publik disajikan lewat render.php supaya data CMS (WhatsApp, gambar,
  # layanan, FAQ, artikel terbaru) diterapkan di server, tanpa JavaScript.
  RewriteRule ^$ render.php?page=index [L]
  RewriteRule ^(index|tentang-kami|kebijakan-privasi|syarat-ketentuan|404)\.html$ render.php?page=$1 [L]

  # Never serve the CMS settings file or uploads folder directly.
  RewriteRule ^data/ - [R=404,L]

  # Hide the local archive folder.
  RewriteRule ^(docs|_arsip)(/|$) - [R=404,L]

  # Redirect lama -> lokasi baru assets/ (favicon & og-image pindah folder).
  RewriteRule ^favicon\.ico$ assets/icons/favicon.ico [R=301,L]
  RewriteRule ^favicon-32x32\.png$ assets/icons/favicon-32x32.png [R=301,L]
  RewriteRule ^apple-touch-icon\.png$ assets/icons/apple-touch-icon.png [R=301,L]
  RewriteRule ^og-image\.jpg$ assets/img/og-image.jpg [R=301,L]
  RewriteRule ^legal\.css$ assets/css/legal.css [R=301,L]

  # Hide the state file left behind by the FTP deploy action.
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [R=404,L]
</IfModule>

# Cache statis 30 hari (CSS/JS/gambar/ikon/font) — mempercepat kunjungan ulang.
# Dibungkus IfModule agar aman bila modul nonaktif di shared hosting.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Kompresi teks (HTML/CSS/JS/SVG/JSON) bila mod_deflate tersedia.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/ld+json
</IfModule>

<IfModule !mod_rewrite.c>
  # Without mod_rewrite the data folder is still protected by the guard inside
  # data/storage.php, and data/uploads/index.php blocks directory listings.
  ErrorDocument 404 /404.html
</IfModule>
